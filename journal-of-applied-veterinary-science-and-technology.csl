<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US" initialize-with-hyphen="false" demote-non-dropping-particle="never">
  <info>
    <title>Journal of Applied Veterinary Science and Technology (JAVEST) — Vancouver</title>
    <title-short>JAVEST — Vancouver</title-short>
    <id>http://www.zotero.org/styles/journal-of-applied-veterinary-science-and-technology</id>
    <link href="http://www.zotero.org/styles/journal-of-applied-veterinary-science-and-technology" rel="self"/>
    <link href="https://e-journal.unair.ac.id/JAVEST" rel="documentation"/>
    <link href="https://www.ncbi.nlm.nih.gov/books/NBK7256/" rel="template"/>
    <author><name>JAVEST Editorial Team</name></author>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>Modified numeric Vancouver style for JAVEST. Bracketed citations, six authors then et al., surname and punctuated initials, English and, full italic journal titles, volume(issue), DOI URLs.</summary>
    <updated>2026-10-09T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This CSL style is distributed under CC BY-SA 3.0, as used by the CSL style repository.</rights>
  </info>
  <locale xml:lang="en-US">
    <terms>
      <term name="and">and</term>
      <term name="et-al">et al.</term>
      <term name="editor" form="short"><single>editor</single><multiple>editors</multiple></term>
      <term name="page" form="short"><single>p.</single><multiple>p.</multiple></term>
    </terms>
  </locale>
  <macro name="authors">
    <choose>
      <if variable="author">
        <names variable="author"><name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="always" et-al-min="7" et-al-use-first="6" delimiter-precedes-et-al="always"/><et-al font-style="italic"/></names>
      </if>
      <else-if variable="editor">
        <names variable="editor"><name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="always" et-al-min="7" et-al-use-first="6" delimiter-precedes-et-al="always"/><label form="long" prefix=", "/></names>
      </else-if>
      <else-if variable="publisher"><text variable="publisher"/></else-if>
    </choose>
  </macro>
  <macro name="editors">
    <names variable="editor"><name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="always" et-al-min="7" et-al-use-first="6" delimiter-precedes-et-al="always"/><label form="long" prefix=", "/></names>
  </macro>
  <macro name="year"><date variable="issued"><date-part name="year"/></date></macro>
  <macro name="full-date"><date variable="issued" form="text" date-parts="year-month-day"/></macro>
  <macro name="access-date"><choose><if variable="accessed"><date variable="accessed" prefix="[cited " suffix="]"><date-part name="year"/><date-part name="month" form="short" prefix=" "/><date-part name="day" prefix=" "/></date></if></choose></macro>
  <macro name="doi-url">
    <choose>
      <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
      <else-if variable="URL"><text variable="URL"/></else-if>
    </choose>
  </macro>
  <macro name="web-link">
    <choose>
      <if variable="DOI"><text variable="DOI" prefix="https://doi.org/"/></if>
      <else-if variable="URL"><text variable="URL" prefix="Available from: "/></else-if>
    </choose>
  </macro>
  <macro name="edition"><choose><if variable="edition"><number variable="edition" form="ordinal" suffix=" ed."/></if></choose></macro>
  <macro name="place-publisher-year">
    <group delimiter=""><group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group><text macro="year" prefix="; "/></group>
  </macro>
  <macro name="volume-issue-pages">
    <group delimiter="">
      <text variable="volume"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=":"/>
    </group>
  </macro>
  <macro name="journal">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title"/>
      <text variable="container-title" font-style="italic"/>
      <group delimiter=""><text macro="year"/><group delimiter="" prefix=";"><text macro="volume-issue-pages"/></group></group>
      <text macro="doi-url"/>
    </group>
  </macro>
  <macro name="book">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title" font-style="italic"/>
      <text macro="edition"/>
      <text macro="place-publisher-year"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="chapter">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title"/>
      <group delimiter=""><text value="In: "/><text macro="editors"/></group>
      <text variable="container-title" font-style="italic"/>
      <text macro="edition"/>
      <text macro="place-publisher-year"/>
      <text variable="page" prefix="p. "/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="thesis">
    <group delimiter=". ">
      <text macro="authors"/>
      <group delimiter=" "><text variable="title" font-style="italic"/><choose><if variable="genre"><text variable="genre" prefix="[" suffix="]"/></if><else><text value="[thesis]"/></else></choose></group>
      <text macro="place-publisher-year"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="conference">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title"/>
      <group delimiter=""><text value="In: "/><text variable="container-title" font-style="italic"/></group>
      <text variable="event"/>
      <text variable="event-place"/>
      <text macro="place-publisher-year"/>
      <text variable="page" prefix="p. "/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="report">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title" font-style="italic"/>
      <text macro="place-publisher-year"/>
      <group delimiter=" "><text variable="genre"/><text variable="number" prefix="No. "/></group>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="webpage">
    <group delimiter=". ">
      <text macro="authors"/>
      <group delimiter=" "><text variable="title"/><text value="[Internet]"/></group>
      <text variable="container-title" font-style="italic"/>
      <text macro="place-publisher-year"/>
      <text macro="access-date"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="dataset-software">
    <group delimiter=". ">
      <text macro="authors"/>
      <group delimiter=" "><text variable="title" font-style="italic"/><choose><if type="dataset"><text value="[dataset]"/></if><else><text value="[software]"/></else></choose></group>
      <text variable="version" prefix="Version "/>
      <text variable="publisher"/>
      <text macro="year"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="patent">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title"/>
      <text variable="number"/>
      <text macro="year"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <macro name="generic">
    <group delimiter=". ">
      <text macro="authors"/>
      <text variable="title"/>
      <text variable="container-title" font-style="italic"/>
      <text variable="genre"/>
      <text macro="place-publisher-year"/>
      <text macro="access-date"/>
      <text macro="web-link"/>
    </group>
  </macro>
  <citation collapse="citation-number" cite-group-delimiter=",">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=","><text variable="citation-number"/></layout>
  </citation>
  <bibliography et-al-min="7" et-al-use-first="6" second-field-align="flush" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal article" match="any"><text macro="journal"/></if>
        <else-if type="chapter entry-encyclopedia entry-dictionary" match="any"><text macro="chapter"/></else-if>
        <else-if type="book" ><text macro="book"/></else-if>
        <else-if type="paper-conference"><text macro="conference"/></else-if>
        <else-if type="thesis"><text macro="thesis"/></else-if>
        <else-if type="report standard" match="any"><text macro="report"/></else-if>
        <else-if type="webpage post post-weblog" match="any"><text macro="webpage"/></else-if>
        <else-if type="dataset software" match="any"><text macro="dataset-software"/></else-if>
        <else-if type="patent"><text macro="patent"/></else-if>
        <else><text macro="generic"/></else>
      </choose>
    </layout>
  </bibliography>
</style>
